# TidyQuest Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=production
PORT=3000

# Security - REQUIRED in production
# Generate a secure random string (at least 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Database (handled by Docker volume, no config needed)
# Database file: ./data/tidyquest.db

# Behind a reverse proxy (nginx, Nginx Proxy Manager, Traefik...): the proxy's addresses, so the login limit
# sees each visitor's own address. Leave unset when nothing sits in front of the server.
# TRUST_PROXY=loopback, 172.16.0.0/12

# Running code you changed? Where people can get your copy, for the "Source code" link (the AGPL asks for this).
# By default the link goes to the TidyQuest release (or :main commit) you run.
# SOURCE_URL=https://github.com/you/your-tidyquest

# Hosted mode only (HOSTED=1): the mail server for sign-up, password and email-change emails. Without SMTP_HOST
# they go to the server log. Port 465 is TLS from the start; other ports must offer STARTTLS.
# SMTP_HOST=mail.example.org
# SMTP_PORT=465
# SMTP_USER=noreply@example.org
# SMTP_PASS=
# EMAIL_FROM=TidyQuest <noreply@example.org>
# EMAIL_REPLY_TO=hello@example.org
